{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://awpl.spice/schema/v1",
  "title": "AWPL Schema",
  "description": "JSON Schema for validating Abstract Workflow Pipeline Language (AWPL) applications",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique name of the application",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Optional description providing context about the application."
    },
    "context": { "$ref": "#/definitions/context" },
    "config": {
      "type": "object",
      "description": "Application-specific configuration",
      "additionalProperties": false,
      "properties": {
        "resource_hints": {
          "$ref": "#/definitions/resourceHints"
        },
        "airflow": {
          "$ref": "#/definitions/airflowConfig"
        },
        "flink": {
          "$ref": "#/definitions/flinkConfig"
        }
      }
    },
    "nodes": {
      "type": "array",
      "description": "List of nodes (tasks, branches, loops, maps)",
      "default": [],
      "items": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task": { "$ref": "#/definitions/taskNode" },
        "branch": { "$ref": "#/definitions/branchNode" },
        "loop": { "$ref": "#/definitions/loopNode" },
        "map": { "$ref": "#/definitions/mapNode" }
      },
      "oneOf": [
        { "required": ["task"] },
        { "required": ["branch"] },
        { "required": ["loop"] },
        { "required": ["map"] }
      ]
    },
    "taskNode": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Optional description"
        },
        "depends_on": {
          "type": "array",
          "description": "List of task/node IDs this depends on",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "context": { "$ref": "#/definitions/context" },
        "task_config": {
          "type": "object",
          "description": "Task-specific configuration",
          "additionalProperties": false,
          "properties": {
            "airflow": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "kubernetes_pod_operator": { "$ref": "#/definitions/kubernetesPodOperator" }
              }
            },
            "flink": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "source": { "$ref": "#/definitions/source" },
                "sink": { "$ref": "#/definitions/sink" },
                "key_by": {
                  "type": "string"
                },
                "filter": { "$ref": "#/definitions/class_only_operator" },
                "flat_map": { "$ref": "#/definitions/class_only_operator" },
                "map": { "$ref": "#/definitions/class_only_operator" },
                "process": { "$ref": "#/definitions/class_only_operator" },
                "reduce": { "$ref": "#/definitions/class_only_operator" },
                "window": { "$ref": "#/definitions/window" },
                "window_all": { "$ref": "#/definitions/window_all" },
                "window_apply": { "$ref": "#/definitions/class_only_operator" },
                "connect": {
                  "type": ["null", "object"],
                  "additionalProperties": false
                },
                "co_map": { "$ref": "#/definitions/class_only_operator" },
                "co_flat_map": { "$ref": "#/definitions/class_only_operator" },
                "union": {
                  "type": ["null", "object"],
                  "additionalProperties": false
                },
                "window_join": { "$ref": "#/definitions/window_join" },
                "interval_join": { "$ref": "#/definitions/interval_join" },
                "timestamp": { "$ref": "#/definitions/class_only_operator" }
              }
            },
            "resource_hints": {
              "$ref": "#/definitions/resourceHints"
            }
          }
        }
      }
    },
    "branchNode": {
      "type": "object",
      "required": ["id", "conditions", "branches"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Optional description"
        },
        "depends_on": {
          "type": "array",
          "description": "List of task/node IDs this depends on",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "combine_conditions_with": {
          "type": "string",
          "description": "Logical operator for combining conditions",
          "enum": ["and", "or"],
          "default": "and"
        },
        "conditions": {
          "type": "array",
          "description": "List of condition objects",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/condition"
          }
        },
        "context": { "$ref": "#/definitions/context" },
        "branches": {
          "type": "object",
          "required": ["true"],
          "additionalProperties": false,
          "properties": {
            "false": {
              "default": [
              ],
              "description": "Nodes to execute if condition is false",
              "items": {
                "$ref": "#/definitions/node"
              },
              "type": "array"
            },
            "true": {
              "description": "Nodes to execute if condition is true",
              "items": {
                "$ref": "#/definitions/condition"
              }
            },
            "combine_conditions_with": {
              "type": "string",
              "description": "Logical operator for combining all conditions",
              "enum": ["and", "or"]
            },
            "branches": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 2,
              "additionalProperties": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/node"
                }
              }
            }
          }
        }
      }
    },
    "loopNode": {
      "type": "object",
      "required": ["id", "conditions", "body", "max_iters"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Optional description"
        },
        "max_iters": {
          "type": "number",
          "description": "Maximum iterations of the loop (loop unrolling)"
        },
        "depends_on": {
          "type": "array",
          "description": "List of task/node IDs this depends on",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "loop_data": {
          "type": "object",
          "description": "Defines loop variable tracking",
          "required": ["id", "init", "loop"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "description": "Identifier for loop variable",
              "minLength": 1
            },
            "init": {
              "type": "string",
              "description": "Reference to task/value for initialization",
              "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*$|^[^$].*$"
            },
            "depends_on": {
              "type": "array",
              "description": "List of task/node IDs this depends on",
              "default": [],
              "items": {
                "type": "string"
              }
            },
            "loop_data": {
              "type": "object",
              "description": "Defines loop variable tracking",
              "required": ["id", "init", "loop"],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Identifier for loop variable",
                  "minLength": 1
                },
                "init": {
                  "type": "string",
                  "description": "Reference to task/value for initialization",
                  "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*$|^[^$].*$"
                },
                "loop": {
                  "type": "string",
                  "description": "Reference to task that updates the variable",
                  "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*$"
                }
              }
            },
            "conditions": {
              "type": "array",
              "description": "Conditions for loop termination",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/condition"
              }
            },
            "combine_conditions_with": {
              "type": "string",
              "description": "Logical operator for combining all conditions",
              "enum": ["and", "or"]
            },
            "body": {
              "type": "array",
              "description": "Nodes executed in each iteration",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/node"
              }
            }
          }
        },
        "combine_conditions_with": {
          "type": "string",
          "description": "Logical operator for combining conditions",
          "enum": ["and", "or"],
          "default": "and"
        },
        "conditions": {
          "type": "array",
          "description": "Conditions for loop termination",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/condition"
          }
        },
        "context": { "$ref": "#/definitions/context" },
        "body": {
          "type": "array",
          "description": "Nodes executed in each iteration",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/node"
          }
        }
      }
    },
    "mapNode": {
      "type": "object",
      "required": ["id", "items"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Optional description"
        },
        "depends_on": {
          "type": "array",
          "description": "List of task/node IDs this depends on",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "items": {
          "description": "Literal list or task reference returning a list",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*$"
            },
            {
              "type": "array"
            }
          ]
        },
        "context": { "$ref": "#/definitions/context" },
        "body": {
          "type": "array",
          "description": "Nodes executed for each list element",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/node"
          }
        }
      }
    },
    "condition": {
      "type": "object",
      "required": ["lhs", "rhs", "operator"],
      "additionalProperties": false,
      "properties": {
        "lhs": {
          "type": "string",
          "description": "Left-hand side (literal or task reference)"
        },
        "rhs": {
          "type": "string",
          "description": "Right-hand side (literal or task reference)"
        },
        "operator": {
          "type": "string",
          "description": "Comparison operator",
          "enum": [">", "<", ">=", "<=", "==", "equals"]
        },
        "negation": {
          "type": "boolean",
          "description": "Whether to negate the condition",
          "default": false
        }
      }
    },
    "resourceHints": {
      "type": "array",
      "description": "List of resource hint objects",
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "description": "Resource type",
            "enum": ["cpu", "memory", "gpu", "storage"]
          },
          "min": {
            "type": "number",
            "description": "Minimum resource amount",
            "default": "0"
          },
          "max": {
            "type": "number",
            "description": "Maximum resource amount"
          }
        }
      }
    },
    "flinkConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parallelism": {
          "type": "integer"
        },
        "libraries": {
          "type": "array",
          "description": "Libraries to be shaded into built jar files",
          "default": [ ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "airflowConfig": {
      "type": "object",
      "required": ["schedule"],
      "additionalProperties": false,
      "properties": {
        "schedule": {
          "type": "string",
          "description": "Cron-style schedule"
        },
        "catchup": {
          "type": "boolean",
          "description": "Whether to catch up on missed runs",
          "default": false
        },
        "tags": {
          "type": "array",
          "description": "Metadata tags",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "default_args": {
          "type": "object",
          "description": "Default arguments",
          "default": {},
          "additionalProperties": false,
          "properties": {
            "owner": {
              "type": "string",
              "description": "Pipeline owner identifier",
              "default": ""
            },
            "retries": {
              "type": "integer",
              "description": "Number of retry attempts",
              "minimum": 0,
              "default": 0
            },
            "retry_delay": {
              "type": "string",
              "description": "Delay between retries (e.g., '5m')",
              "default": "0m"
            },
            "start_date": {
              "type": "string",
              "description": "Start time (ISO 8601 format)"
            },
            "end_date": {
              "type": "string",
              "description": "End time (ISO 8601 format)"
            }
          }
        },
        "is_paused_upon_creation": {
          "type": "boolean",
          "description": "Whether DAG is paused initially",
          "default": false
        }
      }
    },
    "context": {
      "type": "object",
      "description": "Flexible field for arbitrary key-value pairs (e.g., database references, custom flags).",
      "additionalProperties": true
    },
    "kubernetesPodOperator": {
      "type": "object",
      "required": ["name", "image"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Pod name",
          "minLength": 1
        },
        "do_xcom_push": {
          "type": "boolean",
          "description": "Whether to push XComs",
          "default": true
        },
        "namespace": {
          "type": "string",
          "description": "Kubernetes namespace",
          "default": "default"
        },
        "image": {
          "type": "string",
          "description": "Docker image",
          "minLength": 1
        },
        "cmds": {
          "type": "array",
          "description": "Commands to execute",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "arguments": {
          "type": "array",
          "description": "Container entrypoint arguments",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "volumes": {
          "type": "array",
          "description": "Volumes",
          "default": [],
          "items": {
            "type": "object",
            "required": ["name", "claim_name"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "claim_name": {
                "type": "string"
              }
            }
          }
        },
        "volume_mounts": {
          "type": "array",
          "description": "Volume mounts",
          "default": [],
          "items": {
            "type": "object",
            "required": ["name", "mount_path"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "mount_path": {
                "type": "string"
              }
            }
          }
        },
        "env_vars": {
          "type": "array",
          "description": "Environment variables",
          "default": [],
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "valueFrom": {
                "type": "object",
                "required": ["path", "secrets"],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "secrets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "oneOf": [
              {
                "required": ["value"]
              },
              {
                "required": ["valueFrom"]
              }
            ]
          }
        },
        "image_pull_policy": {
          "type": "string",
          "description": "Image pull policy",
          "enum": ["Always", "IfNotPresent", "Never"],
          "default": "Always"
        },
        "config_file": {
          "type": "string",
          "description": "Kubernetes config file path",
          "default": "~/.kube/config"
        },
        "hostnetwork": {
          "type": "boolean",
          "description": "Use host network",
          "default": false
        },
        "skip_on_exit_code": {
          "type": "number",
          "description": "Exit code to treat as skipped"
        }
      }
    },
    "source": {
      "type": "object",
      "oneOf": [
        { "required": ["topic"] },
        { "required": ["socket"] },
        { "required": ["class"] }
      ],
      "additionalProperties": false,
      "properties": {
        "topic": {
          "type": "string"
        },
        "socket": {
          "type": "string"
        },
        "class": {
          "type": "string"
        }
      }
    },
    "sink": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["topic"] },
        { "required": ["stdout"] },
        { "required": ["socket"] },
        { "required": ["class"] }
      ],
      "properties": {
        "topic": {
          "type": "string"
        },
        "stdout": {
          "type": "null"
        },
        "socket": {
          "type": "string"
        },
        "class": {
          "type": "string"
        }
      }
    },
    "class_only_operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "class" ],
      "properties": {
        "class": {
          "type": "string"
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "type", "size" ],
      "properties": {
        "time": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["tumbling", "sliding", "session"]
        },
        "size": {
          "size": "integer"
        },
        "slide": {
          "slide": "integer"
        }
      }
    },
    "window_all": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "type", "size" ],
      "properties": {
        "time": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["tumbling", "sliding", "session"]
        },
        "size": {
          "size": "integer"
        },
        "slide": {
          "slide": "integer"
        }
      }
    },
    "window_join": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "left_key", "right_key", "type", "size", "class" ],
      "properties": {
        "left_key": {
          "type": "string"
        },
        "right_key": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["tumbling", "sliding", "session"]
        },
        "size": {
          "type": "integer"
        },
        "slide": {
          "type": "integer"
        },
        "time": {
          "type": "string",
          "enum": ["event", "processing"]
        },
        "class": {
          "type": "string"
        }
      }
    },
    "interval_join": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "left_key", "right_key", "lower_bound", "upper_bound", "class"],
      "properties": {
        "left_key": {
          "type": "string"
        },
        "right_key": {
          "type": "string"
        },
        "lower_bound": {
          "type": "integer"
        },
        "upper_bound": {
          "type": "integer"
        },
        "class": {
          "type": "string"
        }
      }
    }
  }
}
